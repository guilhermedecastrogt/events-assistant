# Postgres (matches docker-compose.yml; local development only)
# Change POSTGRES_PORT if 5432 is taken locally, and update DATABASE_URL to match.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://events:events@localhost:5432/events

# Anthropic API key for the agent (M4)
ANTHROPIC_API_KEY=

# Kapso API key for WhatsApp (M5)
KAPSO_API_KEY=
